# File mẫu — copy thành .env (cùng thư mục với docker-compose.yml) trước khi chạy `docker compose up`
# .env này CHỈ dùng cho docker-compose, không liên quan tới .env của Next.js dev

# Postgres password (mặc định "postgres" — đổi thành chuỗi mạnh nếu chạy production)
POSTGRES_PASSWORD=postgres

# NextAuth secret — BẮT BUỘC. Sinh chuỗi 32+ ký tự ngẫu nhiên:
#   openssl rand -base64 32
NEXTAUTH_SECRET=please-change-me-to-a-random-32-char-string

# URL mà nhân sự dùng để truy cập app. PHẢI là IP LAN của máy host + :3000
# Ví dụ:
#   - Máy host có IP 192.168.1.50 → NEXTAUTH_URL=http://192.168.1.50:3000
#   - Có domain nội bộ          → NEXTAUTH_URL=http://kol.shop.local
# Lấy IP máy: ipconfig getifaddr en0 (Mac) hoặc hostname -I (Linux)
NEXTAUTH_URL=http://localhost:3000
